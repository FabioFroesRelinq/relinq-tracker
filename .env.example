DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=relinq_tracker_db

# Login do painel (compartilhado pelo time)
PAINEL_USER=admin
PAINEL_PASSWORD=troque-esta-senha

# Chave usada pra assinar o cookie de sessão do login — gere um valor
# aleatório só seu, não use o mesmo em dois ambientes.
# Pra gerar um: openssl rand -hex 32
SESSION_SECRET=

# --- Integração com o GTM server-side (container "[SERVER] Relinq...") ---
# Segredo compartilhado com a tag "Solicitação HTTP" criada no GTM,
# vinculada ao trigger "Todos os Eventos - GA4" já existente. Configure
# o MESMO valor no header "x-gtm-secret" dessa tag. Gere um valor
# aleatório só seu (ex: openssl rand -hex 32) — sem essa variável
# definida, o endpoint recusa qualquer requisição que se diga vinda do
# GTM (fail closed).
GTM_SERVER_SECRET=

# Slugs de site (separados por vírgula, sem espaço) que o endpoint aceita
# vindos do GTM. Por enquanto só a Relinq Sales usa essa integração.
# Exemplo: GTM_SITES_PERMITIDOS=relinq-sales
GTM_SITES_PERMITIDOS=

# Nomes de evento (separados por vírgula) que o endpoint aceita vindos do
# GTM. Como o trigger "Todos os Eventos - GA4" manda TODO evento GA4 pra
# cá, essa lista é o que decide o que realmente vira registro no banco —
# qualquer coisa fora dela é descartada em silêncio. Ajuste aqui, sem
# precisar mexer na configuração do GTM.
# Exemplo: GTM_EVENTOS_PERMITIDOS=lead,generate_lead,purchase
GTM_EVENTOS_PERMITIDOS=
